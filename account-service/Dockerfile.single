# Single server: one Ubuntu container, install everything manually.
# Build: docker build -f Dockerfile.single -t account-service-single .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install PostgreSQL and dependencies (server + client)
RUN apt-get update && apt-get install -y \
    postgresql postgresql-contrib \
    wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*


# Install Go manually (tarball)
RUN wget -q https://go.dev/dl/go1.25.7.linux-amd64.tar.gz -O /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# App lives here
WORKDIR /app

# Copy source and build the binary
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /app/account-service ./cmd/account

# Migrations for entrypoint
COPY db/migrations /app/migrations

# Entrypoint: start Postgres, migrate, run app
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
