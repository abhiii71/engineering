# For single-container run (docker-compose up): app + DB in one container.
# DATABASE_URL is set inside the container by entrypoint.sh; override only if needed.
# Default inside container: postgres://account:secret@localhost:5432/accountdb?sslmode=disable

# For local dev with separate Postgres (go run ./cmd/account):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/account_service?sslmode=disable

PORT=8080
SECRET_KEY=your_secret_key_here
ISSUER=account-service
